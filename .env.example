# Copy to .env  (docker compose reads it automatically)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
RAG_PROVIDER=local          # local = offline demo, vertex = Vertex AI embeddings + Vector Search + Gemini
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
VERTEX_INDEX_ID=
VERTEX_INDEX_ENDPOINT_ID=
VERTEX_DEPLOYED_INDEX_ID=docqa_deployed
VERTEX_PUBLIC_ENDPOINT_DOMAIN=
GOOGLE_ADC_FILE=            # e.g. ~/.config/gcloud/application_default_credentials.json
